# ===================================================
# 同窗录 - 环境配置模板
#
# 📌 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#      (Windows PowerShell: Copy-Item .env.example .env)
#   2. 根据实际环境修改下方配置值
#   3. 请勿将 .env 文件提交到版本控制（已在 .gitignore 中排除）
#
# 💡 配置优先级：
#   .env 文件 > 系统环境变量 > 代码默认值
#
# 🔒 安全提示：
#   - 生产环境必须修改 DJANGO_SECRET_KEY
#   - 生产环境必须将 DJANGO_DEBUG 设为 false
#   - 生产环境必须修改 DJANGO_ALLOWED_HOSTS（不要使用 *）
#   - 生产环境建议启用 HTTPS 相关安全配置
# ===================================================


# ===== Django 基础配置 =====

# 安全密钥 - 【必填】生产环境必须修改！
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# 调试模式 - 开发环境设为 true，生产环境设为 false
DJANGO_DEBUG=true

# 允许访问的主机，多个用英文逗号分隔
# 开发环境可使用 *，生产环境必须指定具体域名
DJANGO_ALLOWED_HOSTS=*

# 开发服务器监听地址（仅用于 python main.py）
DJANGO_RUN_HOST=0.0.0.0

# 开发服务器监听端口（仅用于 python main.py）
DJANGO_RUN_PORT=2323


# ===== 数据库配置 (PostgreSQL) =====

# 数据库名称
DB_NAME=classmates_record

# 数据库用户名
DB_USER=root

# 数据库密码 - 【必填】请设置安全的密码
DB_PASSWORD=your-database-password

# 数据库主机地址（本地开发为 127.0.0.1，Docker 为 db）
DB_HOST=127.0.0.1

# 数据库端口
DB_PORT=5432

# 数据库连接最大存活时间（秒）
# 0 = 每次请求新建连接（当前项目使用此模式）
# 建议在生产环境中设置 60-300
DB_CONN_MAX_AGE=0

# 数据库引擎（通常不需要修改）
# 默认使用 core.db_backend（支持自动重连）
# DB_ENGINE=core.db_backend


# ===== 邮箱配置 (SMTP) =====
# 用于发送注册验证码

# SMTP 服务器地址
# QQ邮箱: smtp.qq.com
# 163邮箱: smtp.163.com
# Gmail: smtp.gmail.com
EMAIL_HOST=smtp.qq.com

# SMTP 端口
# SSL: 465 (QQ/163)
# TLS: 587 (Gmail)
EMAIL_PORT=465

# 是否使用 SSL（465端口必须开启）
EMAIL_USE_SSL=true

# 发件邮箱地址
EMAIL_HOST_USER=your-email@example.com

# 邮箱授权码（不是邮箱密码！）
# QQ邮箱: 设置 → 账户 → POP3/SMTP → 生成授权码
# 163邮箱: 设置 → POP3/SMTP → 开启服务 → 获取授权码
# Gmail: 需要使用 App Password
EMAIL_HOST_PASSWORD=your-email-auth-code

# 默认发件人（通常与 EMAIL_HOST_USER 相同）
DEFAULT_FROM_EMAIL=your-email@example.com


# ===== 会话配置 =====

# Session Cookie 有效期（秒）
# 默认 7 天 = 604800
SESSION_COOKIE_AGE=604800


# ===== 静态与媒体文件 =====

# 静态文件访问路径
STATIC_URL=/static/

# 媒体文件访问路径（用户上传的文件）
MEDIA_URL=/uploads/


# ===== Gunicorn 配置（生产部署） =====

# Gunicorn Worker 进程数（建议 CPU 核心数 * 2 + 1）
GUNICORN_WORKERS=4

# Gunicorn 请求超时时间（秒）
GUNICORN_TIMEOUT=120

# Gunicorn 日志级别（debug/info/warning/error/critical）
GUNICORN_LOGLEVEL=info


# ===== 生产环境 HTTPS 安全配置 =====
# 仅当 DJANGO_DEBUG=false 时生效
# 开发环境无需配置此项

# 是否强制 HTTPS 重定向
SECURE_SSL_REDIRECT=true

# Cookie 仅通过 HTTPS 传输
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# HTTP Strict Transport Security（HSTS）
# 强制浏览器在指定时间内只通过 HTTPS 连接
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true


# ===== 部署说明 =====
#
# 本地开发：
#   1. cp .env.example .env
#   2. 修改 .env 中的配置
#   3. python main.py
#
# Docker 部署：
#   1. cp .env.example .env（docker-compose 会自动读取 .env）
#   2. 修改 .env 中的配置
#   3. docker compose up -d --build
#
# 生产部署（Gunicorn）：
#   1. pip install gunicorn
#   2. gunicorn config.wsgi:application --bind 0.0.0.0:2323
